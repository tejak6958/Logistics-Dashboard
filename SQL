### This script builds your multi-table relational layer. It uses Regex to clean up messy data strings, aggregates the results in a View, 
####and uses a Stored Procedure to write the cleaned payload back into your data warehouse table.
-- ============================================================================
-- 1. BASE OPERATIONAL TABLES (MySQL 8.0+ Compatible)
-- ============================================================================

DROP TABLE IF EXISTS warehouse_analytics_hub;
DROP TABLE IF EXISTS operational_incidents;
DROP TABLE IF EXISTS raw_shipments;
DROP TABLE IF EXISTS carrier_manifests;

CREATE TABLE carrier_manifests (
    carrier_id INT PRIMARY KEY,
    carrier_name VARCHAR(100),
    shipping_zone VARCHAR(10)
) ENGINE=InnoDB;

CREATE TABLE raw_shipments (
    shipment_id INT PRIMARY KEY,
    carrier_id INT,
    metadata_string TEXT, 
    raw_tracking_code VARCHAR(100),
    freight_cost DECIMAL(12, 2),
    FOREIGN KEY (carrier_id) REFERENCES carrier_manifests(carrier_id)
) ENGINE=InnoDB;

CREATE TABLE warehouse_analytics_hub (
    sync_id INT AUTO_INCREMENT PRIMARY KEY, -- Changed from SERIAL to AUTO_INCREMENT
    cleaned_customer_id INT,
    extracted_tracking_number VARCHAR(50),
    carrier_name VARCHAR(100),
    freight_cost DECIMAL(12, 2),
    mongo_incident_count INT,
    sync_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE operational_incidents (
    id INT AUTO_INCREMENT PRIMARY KEY,
    raw_data JSON,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;


-- ============================================================================
-- 2. THE VIEW: Completely translated to MySQL 8.0 REGEXP_SUBSTR
-- ============================================================================

-- ============================================================================
-- 2. THE VIEW: Universally Compatible with ALL MySQL 8.0 Minor Versions
-- ============================================================================

CREATE OR REPLACE VIEW v_clean_premium_logistics AS
SELECT 
    s.shipment_id,
    s.freight_cost,
    c.carrier_name,
    
    -- REGEX 1 FIX: Extracts "ID: 1234" first, then strips away the "ID:" text prefix to isolate the number
    CAST(REGEXP_REPLACE(REGEXP_SUBSTR(s.metadata_string, 'ID:\\s*[0-9]+'), 'ID:\\s*', '') AS UNSIGNED) AS cleaned_customer_id,
    
    -- REGEX 2 FIX: Grabs the trailing portion starting with '#' and strips the '#' symbol away
    REGEXP_REPLACE(REGEXP_SUBSTR(s.raw_tracking_code, '#[0-9]+-[A-Z]+'), '#', '') AS extracted_tracking_number

FROM raw_shipments s
JOIN carrier_manifests c ON s.carrier_id = c.carrier_id
-- Filters for tracking format and premium cost threshold
WHERE s.raw_tracking_code REGEXP '^ERR-TRK#[0-9]+-[A-Z]+$' 
  AND s.freight_cost > 2000.00;



-- ============================================================================
-- 3. THE STORED PROCEDURE: Executes full payload load into target hub
-- ============================================================================

DELIMITER $$

DROP PROCEDURE IF EXISTS sp_execute_warehouse_load$$

CREATE PROCEDURE sp_execute_warehouse_load(
    IN p_batch_id INT,
    OUT p_rows_migrated INT,
    OUT p_log_message TEXT
)
BEGIN
    DECLARE sql_error_code CHAR(5) DEFAULT '00000';
    DECLARE sql_error_msg TEXT;
    
    -- Error Handler: Catch exception and rollback
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        GET DIAGNOSTICS CONDITION 1 
            sql_error_code = RETURNED_SQLSTATE, 
            sql_error_msg = MESSAGE_TEXT;
            
        ROLLBACK;
        SET p_rows_migrated = -1;
        SET p_log_message = CONCAT('ETL Failed for batch ', p_batch_id, '. Error State: ', sql_error_code, '. Message: ', sql_error_msg);
    END;

    START TRANSACTION;
    
    -- ETL WRITE ACTION: Merges view data with aggregated JSON incident metrics
    INSERT INTO warehouse_analytics_hub (cleaned_customer_id, extracted_tracking_number, carrier_name, freight_cost, mongo_incident_count)
    SELECT 
        v.cleaned_customer_id,
        v.extracted_tracking_number,
        v.carrier_name,
        v.freight_cost,
        COALESCE(mongo.incident_count, 0) AS mongo_incident_count
    FROM v_clean_premium_logistics v
    LEFT JOIN (
        -- Inline subquery calculating incident counts directly from JSON array fields
        SELECT 
            raw_data->>'$.extracted_tracking_number' AS tracking_num,
            JSON_LENGTH(raw_data->'$.incident_logs') AS incident_count
        FROM operational_incidents
    ) mongo ON v.extracted_tracking_number = mongo.tracking_num;

    -- Capture exactly how many rows were inserted into the analytical hub
    SET p_rows_migrated = ROW_COUNT();
    
    COMMIT;
    
    SET p_log_message = CONCAT('ETL execution batch ', p_batch_id, ' finalized. ', p_rows_migrated, ' cleaned data records committed.');
END$$

DELIMITER ;


